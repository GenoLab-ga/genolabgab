{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "genolabgab.vercel.app"
        }
      ],
      "destination": "https://genolabgab.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.genolabgab.com"
        }
      ],
      "destination": "https://genolabgab.com/$1",
      "permanent": true
    }
  ]
}
